# Porta em que a API vai rodar
PORT=3000

# Configuracoes de conexao com o PostgreSQL
# Quando rodar via docker-compose, o host é o nome do servico ("db")
# Quando rodar local (sem docker), use "localhost"
DB_HOST=db
DB_PORT=5432
DB_USER=insightai
DB_PASSWORD=insightai123
DB_NAME=insightai_db

# ------------------------------------------------------------
# Versão 3 — Inteligência Artificial (Groq, gratuito)
# ------------------------------------------------------------
# Cole aqui a sua chave gratuita da Groq. Veja o passo a passo
# completo em IA_EXPLICACAO.md — resumo rápido:
#   1. Crie uma conta em https://console.groq.com (não pede cartão)
#   2. Vá em "API Keys" e clique em "Create API Key"
#   3. Cole o valor gerado (começa com "gsk_...") abaixo
GROQ_API_KEY=

# Modelo usado para gerar os insights. openai/gpt-oss-120b é o
# recomendado atualmente pela própria Groq. Só mude isso se a Groq
# depreciar esse modelo também no futuro (veja console.groq.com/docs/deprecations).
GROQ_MODEL=openai/gpt-oss-120b
